{
  "name": "Marketing",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Marketing",
        "description": "Recovered 3,000-row marketing snapshot. No source machine connection. Row-level rates retained for audit; report rates use measures.",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "quarter",
            "dataType": "string",
            "sourceColumn": "quarter",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "month",
            "dataType": "string",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "month_num",
            "dataType": "int64",
            "sourceColumn": "month_num",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "day_of_week",
            "dataType": "string",
            "sourceColumn": "day_of_week",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "is_weekend",
            "dataType": "int64",
            "sourceColumn": "is_weekend",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "campaign",
            "dataType": "string",
            "sourceColumn": "campaign",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "device",
            "dataType": "string",
            "sourceColumn": "device",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "age_group",
            "dataType": "string",
            "sourceColumn": "age_group",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "gender",
            "dataType": "string",
            "sourceColumn": "gender",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "impressions",
            "dataType": "int64",
            "sourceColumn": "impressions",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "clicks",
            "dataType": "int64",
            "sourceColumn": "clicks",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "ctr",
            "dataType": "double",
            "sourceColumn": "ctr",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "cpc",
            "dataType": "decimal",
            "sourceColumn": "cpc",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "spend",
            "dataType": "decimal",
            "sourceColumn": "spend",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "conversions",
            "dataType": "int64",
            "sourceColumn": "conversions",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "conversion_rate",
            "dataType": "double",
            "sourceColumn": "conversion_rate",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "revenue",
            "dataType": "decimal",
            "sourceColumn": "revenue",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "cost_per_conversion",
            "dataType": "decimal",
            "sourceColumn": "cost_per_conversion",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "roas",
            "dataType": "double",
            "sourceColumn": "roas",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0.00\"x\""
          },
          {
            "name": "revenue_per_click",
            "dataType": "decimal",
            "sourceColumn": "revenue_per_click",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "bounce_rate",
            "dataType": "double",
            "sourceColumn": "bounce_rate",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "avg_session_duration_sec",
            "dataType": "double",
            "sourceColumn": "avg_session_duration_sec",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "pages_per_session",
            "dataType": "double",
            "sourceColumn": "pages_per_session",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "engagement_score",
            "dataType": "double",
            "sourceColumn": "engagement_score",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "spend_tier",
            "dataType": "string",
            "sourceColumn": "spend_tier",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "channel_type",
            "dataType": "string",
            "sourceColumn": "channel_type",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "roas_category_fixed",
            "dataType": "string",
            "sourceColumn": "roas_category_fixed",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM ( Marketing[revenue] )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "01 · Volume",
            "description": "Sum of revenue in the current filter context. Amounts use the unspecified source currency."
          },
          {
            "name": "Total Spend",
            "expression": "SUM ( Marketing[spend] )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "01 · Volume",
            "description": "Sum of spend in the current filter context. Amounts use the unspecified source currency."
          },
          {
            "name": "Total Impressions",
            "expression": "SUM ( Marketing[impressions] )",
            "formatString": "#,0",
            "displayFolder": "01 · Volume",
            "description": "Sum of impressions in the current filter context."
          },
          {
            "name": "Total Clicks",
            "expression": "SUM ( Marketing[clicks] )",
            "formatString": "#,0",
            "displayFolder": "01 · Volume",
            "description": "Sum of clicks in the current filter context."
          },
          {
            "name": "Total Conversions",
            "expression": "SUM ( Marketing[conversions] )",
            "formatString": "#,0",
            "displayFolder": "01 · Volume",
            "description": "Sum of conversions in the current filter context."
          },
          {
            "name": "Records",
            "expression": "COUNTROWS ( Marketing )",
            "formatString": "#,0",
            "displayFolder": "01 · Volume",
            "description": "Records"
          },
          {
            "name": "ROAS",
            "expression": "DIVIDE ( [Total Revenue], [Total Spend] )",
            "formatString": "0.00\"x\"",
            "displayFolder": "02 · Efficiency",
            "description": "Total revenue / total spend; weighted ratio of sums, blank when denominator is zero."
          },
          {
            "name": "CTR",
            "expression": "DIVIDE ( [Total Clicks], [Total Impressions] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "displayFolder": "02 · Efficiency",
            "description": "Total clicks / total impressions; weighted ratio of sums, blank when denominator is zero."
          },
          {
            "name": "CVR",
            "expression": "DIVIDE ( [Total Conversions], [Total Clicks] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "displayFolder": "02 · Efficiency",
            "description": "Total conversions / total clicks; weighted ratio of sums, blank when denominator is zero."
          },
          {
            "name": "CPC",
            "expression": "DIVIDE ( [Total Spend], [Total Clicks] )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "02 · Efficiency",
            "description": "Total spend / total clicks; weighted ratio of sums, blank when denominator is zero."
          },
          {
            "name": "CPA",
            "expression": "DIVIDE ( [Total Spend], [Total Conversions] )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "02 · Efficiency",
            "description": "Total spend / total conversions; weighted ratio of sums, blank when denominator is zero."
          },
          {
            "name": "Paid Spend",
            "expression": "CALCULATE ( [Total Spend], KEEPFILTERS ( Marketing[channel_type] = \"Paid\" ) )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "03 · Paid",
            "description": "Paid Spend"
          },
          {
            "name": "Paid Revenue",
            "expression": "CALCULATE ( [Total Revenue], KEEPFILTERS ( Marketing[channel_type] = \"Paid\" ) )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "03 · Paid",
            "description": "Paid Revenue"
          },
          {
            "name": "Paid Clicks",
            "expression": "CALCULATE ( [Total Clicks], KEEPFILTERS ( Marketing[channel_type] = \"Paid\" ) )",
            "formatString": "#,0",
            "displayFolder": "03 · Paid",
            "description": "Paid Clicks"
          },
          {
            "name": "Paid Conversions",
            "expression": "CALCULATE ( [Total Conversions], KEEPFILTERS ( Marketing[channel_type] = \"Paid\" ) )",
            "formatString": "#,0",
            "displayFolder": "03 · Paid",
            "description": "Paid Conversions"
          },
          {
            "name": "Paid ROAS",
            "expression": "DIVIDE ( [Paid Revenue], [Paid Spend] )",
            "formatString": "0.00\"x\"",
            "displayFolder": "03 · Paid",
            "description": "Paid ROAS"
          },
          {
            "name": "Paid CVR",
            "expression": "DIVIDE ( [Paid Conversions], [Paid Clicks] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "displayFolder": "03 · Paid",
            "description": "Paid CVR"
          },
          {
            "name": "Paid CPA",
            "expression": "DIVIDE ( [Paid Spend], [Paid Conversions] )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "03 · Paid",
            "description": "Paid CPA"
          },
          {
            "name": "Organic Revenue",
            "expression": "CALCULATE ( [Total Revenue], KEEPFILTERS ( Marketing[channel_type] = \"Organic\" ) )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "04 · Revenue mix",
            "description": "Organic Revenue"
          },
          {
            "name": "Organic Revenue Share",
            "expression": "DIVIDE ( [Organic Revenue], [Total Revenue] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "displayFolder": "04 · Revenue mix",
            "description": "Organic revenue / revenue inside the current selection; channel filters are preserved."
          },
          {
            "name": "Zero Return Spend",
            "expression": "CALCULATE ( [Total Spend], KEEPFILTERS ( Marketing[spend] > 0 ), KEEPFILTERS ( Marketing[revenue] = 0 ) )",
            "formatString": "#,0.00;(#,0.00);0.00",
            "displayFolder": "05 · Data quality",
            "description": "Spend on rows with spend > 0 and revenue = 0. This is an amount, not a percentage."
          },
          {
            "name": "Zero Return Spend Share",
            "expression": "DIVIDE ( [Zero Return Spend], [Paid Spend] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "displayFolder": "05 · Data quality",
            "description": "Zero-return spend / paid spend; blank if paid spend is zero."
          },
          {
            "name": "CVR Mismatch Rows",
            "expression": "COUNTROWS ( FILTER ( Marketing, Marketing[clicks] > 0 && ABS ( DIVIDE ( Marketing[conversions], Marketing[clicks] ) - Marketing[conversion_rate] ) > 0.01 ) )",
            "formatString": "#,0",
            "displayFolder": "05 · Data quality",
            "description": "Rows where supplied conversion_rate differs from conversions/clicks by more than 0.01 (one percentage point)."
          },
          {
            "name": "CVR Mismatch Share",
            "expression": "DIVIDE ( [CVR Mismatch Rows], [Records] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "displayFolder": "05 · Data quality",
            "description": "CVR Mismatch Share"
          }
        ],
        "partitions": [
          {
            "name": "Marketing",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"date\", \"year\", \"quarter\", \"month\", \"month_num\", \"day_of_week\", \"is_weekend\", \"channel\", \"campaign\", \"region\", \"device\", \"age_group\", \"gender\", \"impressions\", \"clicks\", \"ctr\", \"cpc\", \"spend\", \"conversions\", \"conversion_rate\", \"revenue\", \"cost_per_conversion\", \"roas\", \"revenue_per_click\", \"bounce_rate\", \"avg_session_duration_sec\", \"pages_per_session\", \"engagement_score\", \"spend_tier\", \"channel_type\", \"roas_category_fixed\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"date\", type date}, {\"year\", Int64.Type}, {\"quarter\", type text}, {\"month\", type text}, {\"month_num\", Int64.Type}, {\"day_of_week\", type text}, {\"is_weekend\", Int64.Type}, {\"channel\", type text}, {\"campaign\", type text}, {\"region\", type text}, {\"device\", type text}, {\"age_group\", type text}, {\"gender\", type text}, {\"impressions\", Int64.Type}, {\"clicks\", Int64.Type}, {\"ctr\", type number}, {\"cpc\", type number}, {\"spend\", type number}, {\"conversions\", Int64.Type}, {\"conversion_rate\", type number}, {\"revenue\", type number}, {\"cost_per_conversion\", type number}, {\"roas\", type number}, {\"revenue_per_click\", type number}, {\"bounce_rate\", type number}, {\"avg_session_duration_sec\", type number}, {\"pages_per_session\", type number}, {\"engagement_score\", type number}, {\"spend_tier\", type text}, {\"channel_type\", type text}, {\"roas_category_fixed\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Calendar",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Month Number",
            "dataType": "int64",
            "sourceColumn": "Month Number",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "sortByColumn": "Month Number"
          },
          {
            "name": "Year-Month",
            "dataType": "string",
            "sourceColumn": "Year-Month",
            "summarizeBy": "none",
            "sortByColumn": "Year-Month Sort"
          },
          {
            "name": "Year-Month Sort",
            "dataType": "int64",
            "sourceColumn": "Year-Month Sort",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    StartDate = #date(2025, 1, 1),",
                "    EndDate = #date(2026, 12, 31),",
                "    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),",
                "    Source = Table.FromList(Dates, Splitter.SplitByNothing(), {\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Date\", type date}}),",
                "    Year = Table.AddColumn(Typed, \"Year\", each Date.Year([Date]), Int64.Type),",
                "    MonthNumber = Table.AddColumn(Year, \"Month Number\", each Date.Month([Date]), Int64.Type),",
                "    Month = Table.AddColumn(MonthNumber, \"Month\", each Date.ToText([Date], \"MMM\", \"en-US\"), type text),",
                "    YearMonth = Table.AddColumn(Month, \"Year-Month\", each Date.ToText([Date], \"yyyy-MM\", \"en-US\"), type text),",
                "    YearMonthSort = Table.AddColumn(YearMonth, \"Year-Month Sort\", each [Year] * 100 + [Month Number], Int64.Type)",
                "in",
                "    YearMonthSort"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Marketing_Date_Calendar",
        "fromTable": "Marketing",
        "fromColumn": "date",
        "fromCardinality": "many",
        "toTable": "Calendar",
        "toColumn": "Date",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Marketing\",\"Calendar\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
